# Coolify supplies this when source commits are available during the build.
# For a Git-derived local version, use the full 40-character Git commit SHA.
SOURCE_COMMIT=Version cannot be determined outside a Coolify deployment

# Public application identity
EOLAB_APP_TITLE=EOLab
EOLAB_APP_SUBTITLE=Explore, process, and visualize geospatial data

# Required database secret; set this before the first deployment.
EOLAB_DATABASE_PASSWORD=

# Load the sample Collection and Items after catalog migration.
EOLAB_LOAD_SAMPLE_CATALOG=true

# Browser-facing STAC API path. Keep /stac for the Compose deployment.
EOLAB_CATALOG_URL=/stac

# Host port used only with docker-compose.local.yml.
EOLAB_HOST_PORT=8000

# Public map configuration
EOLAB_BASEMAP_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
EOLAB_BASEMAP_ATTRIBUTION=&copy; OpenStreetMap contributors
EOLAB_INITIAL_LATITUDE=20
EOLAB_INITIAL_LONGITUDE=0
EOLAB_INITIAL_ZOOM=2
