{
  "type": "Feature",
  "stac_version": "1.0.0",
  "stac_extensions": [
    "https://stac-extensions.github.io/datacube/v2.3.0/schema.json"
  ],
  "id": "era5-ncar",
  "collection": "eolab-temporal-datasets",
  "geometry": {
    "type": "Polygon",
    "coordinates": [[[-180, -90], [180, -90], [180, 90], [-180, 90], [-180, -90]]]
  },
  "bbox": [-180, -90, 180, 90],
  "properties": {
    "title": "ERA5 hourly weather",
    "description": "Example temporal GeoTIFF catalog item with three variables and partial observation coverage.",
    "datetime": null,
    "start_datetime": "2000-01-31T22:00:00Z",
    "end_datetime": "2000-02-01T02:00:00Z",
    "eolab:calendar": "proleptic_gregorian",
    "cube:dimensions": {
      "time": {
        "type": "temporal",
        "extent": ["2000-01-31T23:00:00Z", "2000-02-01T02:00:00Z"]
      },
      "y": {
        "type": "spatial",
        "axis": "y",
        "extent": [-90, 90],
        "step": -0.25,
        "unit": "degrees_north",
        "reference_system": 4326
      },
      "x": {
        "type": "spatial",
        "axis": "x",
        "extent": [-180, 179.75],
        "step": 0.25,
        "unit": "degrees_east",
        "reference_system": 4326
      }
    },
    "cube:variables": {
      "2_metre_temperature": {
        "dimensions": ["time", "y", "x"],
        "type": "data",
        "description": "Air temperature at 2 m",
        "unit": "K",
        "data_type": "float32",
        "nodata": "nan",
        "eolab:time_support": "instantaneous"
      },
      "mean_total_precipitation_rate": {
        "dimensions": ["time", "y", "x"],
        "type": "data",
        "description": "Mean precipitation rate over the preceding hour",
        "unit": "kg m**-2 s**-1",
        "data_type": "float32",
        "nodata": "nan",
        "eolab:time_support": "mean_rate"
      },
      "surface_solar_radiation_downwards": {
        "dimensions": ["time", "y", "x"],
        "type": "data",
        "description": "Downward solar energy accumulated over the preceding hour",
        "unit": "W m**-2 s",
        "data_type": "float32",
        "nodata": "nan",
        "eolab:time_support": "accumulation"
      }
    }
  },
  "links": [
